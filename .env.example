# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.
# None of this is needed for `npm run demo`, `npm run verify` or `npm test`.

# Circle developer-controlled wallets (https://console.circle.com)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# The agent's funded Circle wallet on Arc Testnet (holds USDC, pays each settlement)
SPIGOT_AGENT_WALLET_ID=

# That wallet's Arc address. Used to re-derive settlements in `npm run verify`,
# and as the recipient when the agent tops itself up over CCTP.
SPIGOT_AGENT_ADDRESS=

# The provider's Arc address that receives settlement
SPIGOT_PROVIDER_ADDRESS=

# Cross-chain top-up. The key controls the agent's reserve on the SOURCE chain,
# never its Arc spending wallet. Chain names come from Circle's Bridge Kit,
# e.g. Base_Sepolia, Ethereum_Sepolia, Avalanche_Fuji, Arbitrum_Sepolia.
SPIGOT_RESERVE_KEY=
SPIGOT_RESERVE_CHAIN=Base_Sepolia

# Optional overrides for verification
SPIGOT_RPC_URL=
SPIGOT_FROM_BLOCK=
SPIGOT_IMPACT_URL=
