# Copy to .env.local and fill in. .env.local is gitignored - never commit real values.
# None of this is needed for `npm run demo`, `npm run verify` or `npm test`.

# Which Arc network every live path uses. Unset or "mainnet" = Arc mainnet (chain
# 5042, real USDC). "testnet" = Arc Testnet (5042002, faucet USDC), for free runs.
SPIGOT_NETWORK=

# The Arc address that receives settlement.
SPIGOT_PROVIDER_ADDRESS=

# --- Pick ONE way for the agent to pay -------------------------------------

# (a) The quick way: a plain Arc key holding a few USDC on Arc (on testnet, from
#     faucet.circle.com). Generate one with `npm run wallet:new`.
# Set this on the deployment too and the hosted console settles live.
SPIGOT_ARC_KEY=

# (b) Circle developer-controlled wallets (https://console.circle.com)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=

# The agent's funded Circle wallet on Arc (holds USDC, pays each settlement)
SPIGOT_AGENT_WALLET_ID=

# ---------------------------------------------------------------------------

# The agent's own Arc address. Used to re-derive its settlements in
# `npm run verify`, and as the recipient when it tops itself up over CCTP.
SPIGOT_AGENT_ADDRESS=

# Cross-chain top-up. The key controls the agent's reserve on the SOURCE chain,
# never its Arc spending wallet. Chain names come from Circle's Unified Balance
# Kit: Base, Ethereum, Arbitrum, Optimism, Polygon, Avalanche, Unichain on
# mainnet; Base_Sepolia, Ethereum_Sepolia, Arbitrum_Sepolia etc. on testnet.
SPIGOT_RESERVE_KEY=
SPIGOT_RESERVE_CHAIN=Base

# Optional overrides for verification
SPIGOT_RPC_URL=
SPIGOT_FROM_BLOCK=
SPIGOT_IMPACT_URL=
