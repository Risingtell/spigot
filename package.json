{
  "name": "spigot",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native streaming settlement on Arc. Autonomous agents pay per second in USDC for exactly the service-time they hold, and shut their own gate when it stops being worth it.",
  "type": "module",
  "license": "MIT",
  "author": "Oluwasogo \"Israel\" Ajala (Rising Technology)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "tsx examples/demo.ts",
    "verify": "tsx src/verify.ts",
    "agent": "node --env-file-if-exists=.env.local --import tsx src/run-live.ts",
    "topup": "node --env-file-if-exists=.env.local --import tsx src/run-topup.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "nano": "node --env-file-if-exists=.env.local --import tsx src/run-nano.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.14.0",
    "@circle-fin/developer-controlled-wallets": "^10.6.0",
    "@circle-fin/unified-balance-kit": "^1.3.1",
    "@circle-fin/x402-batching": "^3.2.0",
    "@x402/core": "^2.20.0",
    "@x402/evm": "^2.20.0",
    "lucide-react": "^1.28.0",
    "meter402": "^0.1.2",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.55.8"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
